{
  "name": "@intellichain/agent",
  "version": "0.1.0",
  "description": "AI agent stage for Intellichain: watches tweets for gift claims and drives the hardened GetGift Chainlink Functions contract per-user, with env-only configuration",
  "type": "module",
  "main": "src/index.ts",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/index.ts",
    "don-secrets": "tsx scripts/upload-don-secrets.ts"
  },
  "dependencies": {
    "@chainlink/functions-toolkit": "^0.3.2",
    "@elizaos/adapter-sqlite": "0.1.7",
    "@elizaos/client-auto": "0.1.7",
    "@elizaos/client-direct": "0.1.7",
    "@elizaos/core": "0.1.7",
    "@elizaos/plugin-bootstrap": "0.1.7",
    "@elizaos/plugin-node": "0.1.7",
    "@tavily/core": "^0.0.2",
    "agent-twitter-client": "0.0.18",
    "better-sqlite3": "11.5.0",
    "dotenv": "^16.4.7",
    "ethers": "5.7.2",
    "node-cache": "^5.1.2",
    "viem": "^2.22.8",
    "ws": "8.18.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  },
  "pnpm": {
    "overrides": {
      "zod": "3.25.76"
    },
    "onlyBuiltDependencies": [
      "@elizaos/plugin-node",
      "bcrypto",
      "better-sqlite3",
      "bigint-buffer",
      "bufferutil",
      "canvas",
      "eccrypto",
      "es5-ext",
      "esbuild",
      "ffmpeg-static",
      "keccak",
      "node-llama-cpp",
      "onnxruntime-node",
      "protobufjs",
      "puppeteer",
      "secp256k1",
      "sharp",
      "utf-8-validate",
      "wtf_wikipedia",
      "youtube-dl-exec"
    ]
  }
}
