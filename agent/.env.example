# Copy this file to `.env` and fill in YOUR values.
# NEVER commit `.env` — it is gitignored; every placeholder below must be
# replaced by the operator. The agent refuses to boot with missing/invalid
# configuration and names the offending variable.

# ── Network ───────────────────────────────────────────────────────────────────
# One of `sepolia` (default) or `anvil` (the contract's own local preset).
NETWORK=
# JSON-RPC endpoint (free Alchemy/Infura). The agent defaults to Sepolia.
SEPOLIA_RPC_URL=
# Optional: archive/mainnet fork RPC for conversation-side chain context.
MAINNET_RPC_URL=

# Relayer wallet that signs sendRequest() — must be allowlisted on the
# contract and funded with Sepolia ETH + enough LINK on the subscription.
# ⚠️ Use a dedicated key; never a cold-storage or donor key.
EVM_PRIVATE_KEY=

# Deployed GetGift proxy-less address (from `make deploy` in contract/).
CONTRACT_ADDRESS=

# Chainlink Functions billing + DON secrets knobs (see the ROOT README's
# "Chainlink Functions: subscription & secrets" — or use `make don-secrets`
# below to automate the secret upload and write these back).
FUNCTIONS_SUBSCRIPTION_ID=
FUNCTIONS_SLOT_ID=
FUNCTIONS_SECRET_VERSION=

# Fulfillment monitoring: poll every TICK ms for at most MAX_TICKS ticks
# (defaults: every 15s for up to 60 ticks = 15 minutes before "still pending").
FULFILLMENT_TICK_MS=
FULFILLMENT_MAX_TICKS=

# Supabase service key ONLY for the DON-secrets upload script (script run).
SUPABASE_API_KEY=

# ── Twitter ──────────────────────────────────────────────────────────────────
# App account that watches mentions and replies with claim instructions.
TWITTER_USERNAME=
TWITTER_EMAIL=
TWITTER_PASSWORD=
# Optional TOTP base32 secret (2FA protects automated logins).
TWITTER_2FA_SECRET=

# Comma-separated list of accounts the agent watches for gift claims.
TWITTER_TARGET_USERS=
# Enable proactive hashtag/keyword search (more API surface, slower).
TWITTER_SEARCH_ENABLE=false

# ── Twitter-layer knobs (vendored starter defaults; all optional) ─────────────
TWITTER_DRY_RUN=false
MAX_TWEET_LENGTH=280
TWITTER_RETRY_LIMIT=5
TWITTER_POLL_INTERVAL=120
POST_INTERVAL_MIN=90
POST_INTERVAL_MAX=180
ENABLE_ACTION_PROCESSING=false
ACTION_INTERVAL=5
POST_IMMEDIATELY=false
TWITTER_SPACES_ENABLE=false

# ── Model provider (pick ONE; the others may stay empty) ─────────────────────
# Precedence: OPENAI_API_KEY -> OPENROUTER_API_KEY -> CLOUD. CLOUD keys ride
# the OPENAI-compatible surface (elizaOS 0.1.7 has no CLOUD provider).
#
# FREE self-hosted route (recommended): run FreeLLMAPI
#   https://github.com/abdulsamed1/freellmapi
# It aggregates free provider tiers behind ONE OpenAI-compatible /v1 endpoint
# (default http://localhost:3001/v1; keys stored encrypted in its dashboard).
#   1. Start FreeLLMAPI and copy your unified key from the dashboard Keys page
#      (it starts with "freellmapi-").
#   2. Fill the exact rows below:
#        OPENAI_API_URL=http://localhost:3001/v1
#        OPENAI_API_KEY=freellmapi-your-unified-key
#      The key goes ONLY in .env (never in Git); elizaOS reads
#      OPENAI_API_URL straight from process.env, so this just works.
#   3. Optionally pin per-size models with the auto-router strategies
#      ("auto:fast" / "auto" / "auto:smart") — see its REST-API docs for
#      profiles, families and exact model ids.
CLOUD=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Custom OpenAI-compatible endpoint for the OpenAI/CLOUD surface (passthrough,
# e.g. your FreeLLMAPI router):
OPENAI_API_URL=
# Optional per-size model pinning, read by elizaOS straight from the env (the
# -- key format is exactly <SIZE>_<PROVIDER>_MODEL, e.g. for FreeLLMAPI
# leave unset for auto or fill with auto:fast / auto / auto:smart):
SMALL_OPENAI_MODEL=
MEDIUM_OPENAI_MODEL=
LARGE_OPENAI_MODEL=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Direct-client API port (character.json server default).
SERVER_PORT=3000
# Optional SQLite file override (defaults to agent/data/db.sqlite).
SQLITE_FILE=
