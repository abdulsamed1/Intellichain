# Copy this file to `.env` (Makefile auto-loads and exports it for every target).
# NEVER commit `.env` — real keys live only on your machine or in CI secrets.

# RPC endpoints (free accounts from Alchemy or Infura)
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=

# Required for contract verification on Sepolia (etherscan.io account)
ETHERSCAN_API_KEY=

# Wallet used for deployments and interactions (fund it with Sepolia ETH + LINK)
PRIVATE_KEY=

# Deployed contract / wallet used by the `cast` interaction targets
CONTRACT_ADDRESS=
WALLET_ADDRESS=

# Your own Chainlink Functions subscription (from `make create-subscription`).
# Overrides the NetworkConfigLibrary network default, which ships the
# template author's own Sepolia id (4953) — a fresh deployment MUST set this.
FUNCTIONS_SUBSCRIPTION_ID=

# Forge script identifiers (defaults match this repo).
# Deploy uses SCRIPT_FILE (the deploy script holds run()); CONTRACT_NAME is
# only consumed by `make verify` / `make abi`.
CONTRACT_NAME=src/GetGift.sol:GetGift
SCRIPT_FILE=script/DeployGetGift.s.sol:DeployGetGift

# Function signature and args for `make interact` / `make send` + target args
# (`SALT`, `VALUE`, `TX_HASH`, …). `make verify` does not use FUNCTION.
FUNCTION=
